{
  "name": "trustcert-backend",
  "version": "1.0.0",
  "description": "TrustCert Express + TypeScript Backend Core",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
